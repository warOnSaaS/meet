{
  "$schema": "https://raw.githubusercontent.com/warOnSaaS/suite/main/packages/manifest/wos-app.schema.json",
  "id": "meet",
  "name": "Meetings",
  "description": "Video meetings for small teams: direct calls for up to 4, computers in the call carry bigger ones, LiveKit when you have it. AI notes written on each person's own device.",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "requires": {
    "core": ">=0.1"
  },
  "tools": "./tools.json",
  "server": "./server.mjs",
  "screens": "./dist/screens.mjs",
  "icon": "video",
  "nav": {
    "label": "Meetings",
    "order": 40
  },
  "events": {
    "emits": [
      "meet.chat.message",
      "meet.host.offered",
      "meet.meeting.cancelled",
      "meet.meeting.created",
      "meet.meeting.ended",
      "meet.meeting.scheduled",
      "meet.meeting.updated",
      "meet.notes.consent",
      "meet.notes.sent",
      "meet.notes.started",
      "meet.notes.stopped",
      "meet.notes.written",
      "meet.participant.asked",
      "meet.participant.denied",
      "meet.participant.hand",
      "meet.participant.joined",
      "meet.participant.left",
      "meet.participant.media",
      "meet.participant.muted",
      "meet.participant.removed",
      "meet.participant.role",
      "meet.settings.changed",
      "meet.share.requested",
      "meet.share.started",
      "meet.share.stopped",
      "meet.transcript.added",
      "meet.transcript.deleted",
      "meet.recording.asked",
      "meet.recording.consent",
      "meet.recording.stopped",
      "meet.recording.saved",
      "meet.recording.deleted"
    ],
    "listens": []
  },
  "needs": {
    "services": [
      "livekit (optional, compose profile meetings)",
      "turn (optional, coturn or LiveKit's built-in TURN)"
    ],
    "permissions": [
      "camera",
      "microphone",
      "display-capture"
    ],
    "desktop": [
      "participant host: runs host/host.mjs in the background, see docs/DESKTOP-HOST.md"
    ],
    "env": [
      "DATABASE_URL",
      "SESSION_SECRET",
      "PUBLIC_URL",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "STUN_URLS",
      "TURN_URLS",
      "TURN_SECRET",
      "TURN_USERNAME",
      "TURN_CREDENTIAL",
      "LIVEKIT_URL",
      "LIVEKIT_API_KEY",
      "LIVEKIT_API_SECRET",
      "P2P_MAX",
      "NOTES_MODEL_URL",
      "NOTES_MODEL",
      "NOTES_MODEL_KEY",
      "TRANSCRIBE_URL",
      "TRANSCRIBE_MODEL",
      "TRANSCRIBE_KEY",
      "S3_ENDPOINT",
      "S3_BUCKET",
      "S3_REGION",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY"
    ]
  },
  "data": {
    "onDisable": "keep",
    "exports": [
      "meetings",
      "meeting_participants",
      "meeting_chat",
      "meet_segments",
      "meeting_notes",
      "meet_notes_consents",
      "meet_recordings",
      "meet_recording_consents"
    ]
  }
}
