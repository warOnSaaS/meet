# wOS Meetings settings. Copy to .env. Only SESSION_SECRET is required.

# A long random string that signs sign-in sessions and meeting tickets: openssl rand -hex 32
SESSION_SECRET=
# Your domain (docker compose uses it for HTTPS) and the address people use.
DOMAIN=meet.example.com
PUBLIC_URL=https://meet.example.com
# Any Postgres. Unset: SQLite in ./data/meet.db.
# DATABASE_URL=postgres://user:pass@host:5432/meet

# GitHub sign-in: create an OAuth app at github.com/settings/developers with the callback
# https://<your domain>/auth/github/callback. GITHUB_ALLOW limits sign-in to these logins (comma separated).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOW=
# Let anyone start a meeting without signing in (a public demo). Off by default.
OPEN_CREATE=0

# STUN servers (public ones by default) and an optional TURN relay. With TURN_SECRET, browsers get
# short-lived credentials (coturn's use-auth-secret), so the secret never leaves the server.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# TURN_URLS=turn:meet.example.com:3478,turns:meet.example.com:5349
# TURN_SECRET=

# Direct calls up to this many people (default 4). Bigger calls need a computer in the call or LiveKit.
# P2P_MAX=4

# LiveKit, when you run one (docker compose --profile meetings) or use LiveKit Cloud.
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
